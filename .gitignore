cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/

# Django
*.log
local_settings.py
db.sqlite3
media/

# Docker
pgdata/

# Coverage
htmlcov/
.coverage
.coverage.*
.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
*.env.local

# OS
.DS_Store
Thumbs.db
EOF
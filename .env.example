# Скопируйте файл в .env и замените значения.
# .env не попадает в git.

# Django
SECRET_KEY=generate-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=sky_tbook
DB_USER=sky_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Windows использует кодировку CP1251 вместо UTF-8
PYTHONIOENCODING=utf-8

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Stripe (тестовые ключи: https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
